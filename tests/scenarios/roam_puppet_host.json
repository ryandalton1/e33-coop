{
  "name": "roam_puppet_host",
  "description": "Free roam: the fake client (shown as Lune) walks 3 m circles around the host. The host spawns a walking puppet (AI controller, movement input: animated), shows the sender's character, never snaps more than now and then. Screenshots every 2 s: Lune, walking animation.",
  "save": "e33lanes-test/TEST_B",
  "timeout_s": 300,
  "shots_every_s": 2,
  "explore": [
    {
      "do": "wait",
      "until": "roam_states_rx",
      "is": ">=40",
      "timeout": 120
    },
    {
      "do": "wait",
      "s": 20
    }
  ],
  "launch_args": [
    "-e33role=host",
    "-e33port=7777",
    "-e33freeroam=1"
  ],
  "fakepeer": {
    "start": "after_game",
    "args": [
      "client",
      "--connect",
      "127.0.0.1:7777",
      "--script",
      "{repo}/tests/scenarios/fakeclient_roam.json",
      "--record",
      "{run}/recording-fakeclient.jsonl",
      "--timeout",
      "300"
    ],
    "stop_ok": true
  },
  "expect": {
    "roam_states_rx": ">=100",
    "roam_puppets_spawned": ">=1",
    "roam_puppet_spawn_failures": "0",
    "roam_puppets_walking": ">=1",
    "roam_puppet_character_switches": ">=1",
    "roam_puppet_character_errors": "0"
  }
}