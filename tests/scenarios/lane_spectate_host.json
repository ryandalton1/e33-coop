  "encounter": "SM_Lancelier_Alpha",
  "timeout_s": 900,
  "wait_players": 1,
  "max_turns": 60,
  "action_delay_s": 1.0,
  "combo_auto_success": 10,
  "actions": [
    {
      "type": "attack",
      "target": 0
    }
  ],
  "defense": [
    "fail"
  ],
  "launch_args": [
    "-e33role=host",
    "-e33port=7777",
    "-e33lanes=1",
    "-e33lanehp=2",
    "-e33seed=16250036901998647475"
  ],
  "fakepeer": {
